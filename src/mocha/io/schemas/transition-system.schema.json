{
  "$schema": "https://json-schema.org/draft/2020-12/schema",

  "title": "MoChA Transition System",
  "description": "A labelled transition system used by the MoChA framework.",

  "type": "object",
  "additionalProperties": false,

  "required": [
    "schema_version",
    "kind",
    "states",
    "actions",
    "initial_states",
    "atomic_propositions",
    "labels",
    "transitions"
  ],

  "properties": {
    "schema_version": {
      "const": 1
    },

    "kind": {
      "const": "transition_system"
    },

    "states": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },

    "actions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },

    "initial_states": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },

    "atomic_propositions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },

    "labels": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "uniqueItems": true
      }
    },

    "transitions": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "prefixItems": [
          {
            "type": "string"
          },
          {
            "type": "string"
          },
          {
            "type": "string"
          }
        ],
        "items": false
      },
      "uniqueItems": true
    }
  }
}
